*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:"Tajawal","Cairo","Segoe UI",Tahoma,system-ui,sans-serif;font-size:16px}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
img{max-width:100%;display:block}
.hidden{display:none!important}

/* header */
header{position:sticky;top:0;z-index:20;background:var(--choc);color:#fff;padding:10px 14px calc(10px);box-shadow:0 4px 18px rgba(0,0,0,.18)}
.hrow{display:flex;align-items:center;gap:10px;max-width:1100px;margin:0 auto}
.brand{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
.brand img{width:46px;height:46px;object-fit:contain;background:#fff;border-radius:12px;padding:3px}
.brand b{font-size:18px;display:block;line-height:1.1}
.brand small{opacity:.75;font-size:12px}
.cartbtn{position:relative;background:var(--brand);color:#fff;border-radius:14px;padding:9px 14px;font-weight:700;display:flex;gap:6px;align-items:center}
.cartbtn .n{background:#fff;color:var(--brand-d);border-radius:99px;min-width:22px;height:22px;display:inline-grid;place-items:center;font-size:13px;padding:0 6px}
.search{max-width:1100px;margin:10px auto 0;display:flex;gap:8px}
.search input{flex:1;border:0;border-radius:12px;padding:11px 14px;background:#fff;color:var(--ink)}

main{max-width:1100px;margin:0 auto;padding:12px 12px 120px}
.banner{background:linear-gradient(135deg,#FFE3D0,#FDE2EA);border-radius:var(--r);padding:14px 16px;margin-bottom:12px;display:flex;gap:10px;align-items:center;font-weight:700}
.banner span{font-size:26px}
.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 0 10px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{white-space:nowrap;background:#fff;border:1.5px solid var(--line);border-radius:99px;padding:8px 14px;font-weight:600;font-size:14px}
.chip.on{background:var(--choc);border-color:var(--choc);color:#fff}

.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:640px){.grid{grid-template-columns:repeat(3,1fr)}}
@media(min-width:960px){.grid{grid-template-columns:repeat(4,1fr)}}
.p{background:var(--card);border-radius:var(--r);overflow:hidden;box-shadow:0 2px 10px rgba(59,31,20,.06);display:flex;flex-direction:column}
.p .ph{aspect-ratio:1/1;background:#F6EEE7;display:grid;place-items:center;overflow:hidden}
.p .ph img{width:100%;height:100%;object-fit:cover}
.p .ph .noimg{font-size:42px;opacity:.5}
.p .b{padding:10px 11px 12px;display:flex;flex-direction:column;gap:6px;flex:1}
.p .nm{font-weight:700;font-size:15px;line-height:1.3}
.p .cat{font-size:12px;color:var(--muted)}
.price{font-weight:800;color:var(--brand-d);font-size:17px}
.price small{font-weight:600;color:var(--muted);font-size:12px}
.p .add{margin-top:auto;background:var(--brand);color:#fff;border-radius:12px;padding:9px;font-weight:700}
.p.out{opacity:.55}
.p.out .add{background:#bbb}
.tag{display:inline-block;font-size:11px;font-weight:700;border-radius:99px;padding:2px 8px;background:#FFF0E3;color:var(--brand-d)}
.empty{text-align:center;color:var(--muted);padding:50px 10px}
.empty b{display:block;font-size:40px;margin-bottom:8px}

/* sheet / modal */
.ov{position:fixed;inset:0;background:rgba(30,15,8,.45);z-index:50;display:flex;align-items:flex-end;justify-content:center}
.sheet{background:#fff;width:100%;max-width:560px;max-height:92vh;overflow:auto;border-radius:24px 24px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom));animation:up .22s ease-out}
@media(min-width:700px){.ov{align-items:center}.sheet{border-radius:24px}}
@keyframes up{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
.sheet h2{margin:0 0 12px;font-size:20px;display:flex;justify-content:space-between;align-items:center}
.x{font-size:26px;line-height:1;color:var(--muted);padding:4px 8px}
.qopts{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}
.qopt{border:1.5px solid var(--line);border-radius:12px;padding:10px 12px;font-weight:700;background:#fff}
.qopt.on{border-color:var(--brand);background:#FFF0E3;color:var(--brand-d)}
.stepper{display:flex;align-items:center;gap:12px;margin:10px 0}
.stepper button{width:44px;height:44px;border-radius:12px;background:#F6EEE7;font-size:22px;font-weight:800}
.stepper input{width:90px;text-align:center;border:1.5px solid var(--line);border-radius:12px;padding:10px;font-weight:800;font-size:18px}
.total{display:flex;justify-content:space-between;align-items:center;font-weight:800;font-size:18px;padding:12px 0;border-top:1.5px dashed var(--line);margin-top:6px}
.btn{display:block;width:100%;text-decoration:none;background:var(--brand);color:#fff;border-radius:14px;padding:14px;font-weight:800;font-size:17px;text-align:center}
.btn.dark{background:var(--choc)}
.btn.ghost{background:#F6EEE7;color:var(--ink)}
.btn.green{background:#1FAF5A}
.btn:disabled{opacity:.5}
label.f{display:block;margin:10px 0 4px;font-weight:700;font-size:14px}
.in{width:100%;border:1.5px solid var(--line);border-radius:12px;padding:12px;background:#fff}
.in:focus{outline:2px solid var(--brand);border-color:transparent}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.err{color:var(--bad);font-size:13px;margin-top:6px;min-height:1em}
.ci{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.ci img,.ci .ni{width:56px;height:56px;border-radius:12px;object-fit:cover;background:#F6EEE7;display:grid;place-items:center;flex:none}
.ci .t{flex:1;min-width:0}
.ci .t b{display:block;font-size:15px}
.ci .t small{color:var(--muted)}
.ci .rm{color:var(--bad);font-size:13px;font-weight:700;padding:6px}
.note{background:#FFF7E8;border-radius:12px;padding:10px 12px;font-size:14px;color:#7A5A12;margin:8px 0}
.okbox{text-align:center;padding:10px 0}
.okbox .big{font-size:56px}
.okbox .code{font-size:24px;font-weight:800;color:var(--brand-d);letter-spacing:1px}

.fab{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);z-index:30;width:min(520px,calc(100% - 24px));box-shadow:0 10px 30px rgba(232,114,28,.4)}
footer{text-align:center;color:var(--muted);font-size:13px;padding:20px 10px 30px}
footer a{color:var(--brand-d);font-weight:700;text-decoration:none}

/* admin */
.tabs{display:flex;gap:8px;margin:4px 0 14px}
.tab{flex:1;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:11px;font-weight:800}
.tab.on{background:var(--choc);color:#fff;border-color:var(--choc)}
.card{background:#fff;border-radius:var(--r);padding:14px;box-shadow:0 2px 10px rgba(59,31,20,.06);margin-bottom:12px}
.arow{display:flex;gap:10px;align-items:center}
.arow img,.arow .ni{width:54px;height:54px;border-radius:12px;object-fit:cover;background:#F6EEE7;flex:none;display:grid;place-items:center}
.arow .t{flex:1;min-width:0}
.arow .t b{display:block}
.arow .t small{color:var(--muted)}
.mini{background:#F6EEE7;border-radius:10px;padding:8px 12px;font-weight:700;font-size:14px}
.mini.red{background:#FDE7E5;color:var(--bad)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px}
.stat{background:#fff;border-radius:14px;padding:10px;text-align:center;box-shadow:0 2px 10px rgba(59,31,20,.06)}
.stat b{display:block;font-size:20px}
.stat small{color:var(--muted);font-size:12px}
.st{font-size:12px;font-weight:800;border-radius:99px;padding:3px 10px;white-space:nowrap}
.st-new{background:#E8F1FF;color:#2559C7}.st-conf{background:#FFF3DC;color:#A86A00}.st-ship{background:#EFE6FF;color:#6A3FC7}.st-done{background:#E3F6EC;color:var(--ok)}.st-cancel{background:#FDE7E5;color:var(--bad)}
.ord .items{margin:8px 0;padding:8px 10px;background:#FBF6F1;border-radius:12px;font-size:14px}
.ord .items div{display:flex;justify-content:space-between;gap:8px;padding:3px 0}
.ord .acts{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.ord .who{font-size:14px;line-height:1.7}
.seg{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}
.seg button{border:1.5px solid var(--line);border-radius:10px;padding:8px 12px;font-weight:700;background:#fff;font-size:14px}
.seg button.on{background:var(--brand);border-color:var(--brand);color:#fff}
.imgpick{display:flex;gap:12px;align-items:center}
.imgpick .prev{width:84px;height:84px;border-radius:14px;background:#F6EEE7;object-fit:cover;display:grid;place-items:center;font-size:30px}
.demo{background:#FFF0E3;color:var(--brand-d);font-size:13px;font-weight:700;text-align:center;padding:6px 10px}
.toast{position:fixed;top:14px;left:50%;transform:translateX(-50%);background:var(--choc);color:#fff;padding:10px 18px;border-radius:12px;z-index:99;font-weight:700;box-shadow:0 8px 24px rgba(0,0,0,.25)}

/* البون */
.bonwrap{display:flex;justify-content:center;padding:4px 0 10px}
.bon{width:340px;max-width:100%;background:#fff;color:#111;font-family:"Segoe UI",Tahoma,Arial,sans-serif;direction:ltr;padding:14px 12px 12px;border:1px solid #e6e6e6;border-radius:6px;box-shadow:0 4px 18px rgba(0,0,0,.08)}
.bon .c{text-align:center}
.bon .logo{width:84px;height:auto;margin:0 auto 4px;display:block}
.bon h3{margin:2px 0 2px;font-size:21px;text-align:center}
.bon .sub{text-align:center;font-size:12.5px;line-height:1.5}
.bon .band{background:#1d1d1d;color:#fff;text-align:center;font-weight:800;padding:6px;margin:8px 0;font-size:15px;letter-spacing:.5px}
.bon .kv{display:flex;justify-content:space-between;gap:8px;font-size:13px;padding:1.5px 0}
.bon .kv b{font-weight:700;text-align:right}
.bon .cli{border:1.5px solid #222;margin:8px 0;font-size:13px}
.bon .cli div{display:flex;border-bottom:1px solid #222}
.bon .cli div:last-child{border-bottom:0}
.bon .cli span{padding:4px 6px}
.bon .cli span:first-child{width:76px;flex:none;border-right:1px solid #222;font-weight:700;background:#f2f2f2;font-size:11px;line-height:1.25;text-align:center}
.bon .cli span:last-child{flex:1;direction:rtl;text-align:right}
.bon table{width:100%;border-collapse:collapse;margin:8px 0 6px;font-size:13px}
.bon th,.bon td{border:1.5px solid #222;padding:5px 4px;text-align:center;vertical-align:middle}
.bon th{background:#1d1d1d;color:#fff;font-size:11.5px;line-height:1.25;font-weight:700}
.bon td.n{text-align:right;direction:rtl;font-weight:700}
.bon td.m{text-align:right;font-weight:800;white-space:nowrap}
.bon td.d{color:#999}
.bon .tot{display:flex;justify-content:space-between;align-items:center;border:2px solid #111;background:#1d1d1d;color:#fff;border-radius:8px;padding:10px 12px;margin:8px 0;font-weight:900;font-size:21px}
.bon .tot small{font-size:12px;font-weight:600;opacity:.8;display:block}
.bon .bc{display:flex;justify-content:center;margin:8px 0 2px}
.bon .bc svg{max-width:240px;height:auto}
.bon .dash{border-top:1.5px dashed #555;margin:8px 0}
.bon .merci{text-align:center;font-size:13px;line-height:1.6}
.bonacts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
@media print{
  @page{size:80mm auto;margin:3mm}
  body *{visibility:hidden!important}
  #bonPrint,#bonPrint *{visibility:visible!important}
  #bonPrint{position:absolute;left:0;top:0;width:74mm;border:0;box-shadow:none;padding:0}
  .ov{background:none!important}
}
</style>
