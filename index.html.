  --bg:#FFF8F1; --card:#FFFFFF; --ink:#2B1810; --muted:#8A7266; --line:#F0E2D6;
  --brand:#E8721C; --brand-d:#C65A0E; --choc:#3B1F14; --pink:#F2A7B8; --mint:#7CC8B4;
  --ok:#1F9D63; --warn:#D98A00; --bad:#D6453D; --r:18px;
