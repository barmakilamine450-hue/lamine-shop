<script>
/* ============================================================
   1) الإعدادات — بدّل هادو قبل ما تنشر الموقع
   ============================================================ */
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyCZ-GsBgjSe1eW_HWeTcVl8NtCs1-WEtZk",
  authDomain: "lamine-shop-c9e67.firebaseapp.com",
  projectId: "lamine-shop-c9e67",
  storageBucket: "lamine-shop-c9e67.firebasestorage.app",
  messagingSenderId: "611800505961",
  appId: "1:611800505961:web:ca31d6b0b41a4a6c8f4cf8"
};
const ADMIN_EMAILS = ["nizarlamintopup@gmail.com"]; // الإيميلات اللي يقدروا يدخلو لوحة المدير
const SHOP = {
  name: "Lamine Emballage",
  tagline: "عالم متكامل لمواد الحلويات والتغليف",
  whatsapp: "0665813629",
  phones: ["0665 81 36 29", "0674 08 23 48"],
  delivery: "🚚 التوصيل متوفر لـ 69 ولاية",
  ratlGrams: 500,         // الرطل = 500 غرام (بدّلها إذا تحب)
  address: "Adrar / Aoulef / Oumanat",
  payment: "الدفع عند الاستلام"
};
let LOGO = "data:image/png;base64,";

const WILAYAS = ["أدرار","الشلف","الأغواط","أم البواقي","باتنة","بجاية","بسكرة","بشار","البليدة","البويرة","تمنراست","تبسة","تلمسان","تيارت","تيزي وزو","الجزائر","الجلفة","جيجل","سطيف","سعيدة","سكيكدة","سيدي بلعباس","عنابة","قالمة","قسنطينة","المدية","مستغانم","المسيلة","معسكر","ورقلة","وهران","البيض","إليزي","برج بوعريريج","بومرداس","الطارف","تندوف","تيسمسيلت","الوادي","خنشلة","سوق أهراس","تيبازة","ميلة","عين الدفلى","النعامة","عين تموشنت","غرداية","غليزان","تيميمون","برج باجي مختار","أولاد جلال","بني عباس","عين صالح","عين قزام","تقرت","جانت","المغير","المنيعة","آفلو","بريكة","القنطرة","بئر العاتر","العريشة","قصر الشلالة","عين وسارة","مسعد","قصر البخاري","بوسعادة","الأبيض سيدي الشيخ"];
const STATUS = {new:"جديدة",conf:"مؤكدة",ship:"مبعوثة",done:"مستلمة",cancel:"ملغاة"};

/* ============================================================
   2) التخزين: Firebase أو وضع التجربة (localStorage)
   ============================================================ */
const $ = (s, r=document) => r.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt = n => Math.round(n).toLocaleString("fr-DZ").replace(/ | /g," ") + " دج";
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2,7);
function toast(t){const e=$("#toast");e.textContent=t;e.classList.remove("hidden");clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.add("hidden"),2200)}
function ls(k,v){try{if(v===undefined)return JSON.parse(localStorage.getItem(k)||"null");localStorage.setItem(k,JSON.stringify(v))}catch(e){return null}}

const Demo = {
  subs:{p:[],o:[]},
  _get(k){return ls("le_"+k)||[]}, _set(k,v){ls("le_"+k,v);(this.subs[k]||[]).forEach(f=>f(v))},
  watchProducts(cb){this.subs.p.push(cb);cb(this._get("p"))},
  saveProduct(p){const a=this._get("p");const i=a.findIndex(x=>x.id===p.id);if(i>=0)a[i]=p;else a.unshift(p);this._set("p",a);return Promise.resolve()},
  deleteProduct(id){this._set("p",this._get("p").filter(x=>x.id!==id));return Promise.resolve()},
  createOrder(o){const a=this._get("o");a.unshift(o);this._set("o",a);return Promise.resolve()},
  watchOrders(cb){this.subs.o.push(cb);cb(this._get("o"));return()=>{}},
  updateOrder(id,patch){const a=this._get("o").map(x=>x.id===id?{...x,...patch}:x);this._set("o",a);return Promise.resolve()},
  deleteOrder(id){this._set("o",this._get("o").filter(x=>x.id!==id));return Promise.resolve()},
  watchSettings(cb){this.subs.s=this.subs.s||[];this.subs.s.push(cb);cb(ls("le_settings")||{})},
  saveSettings(v){ls("le_settings",v);(this.subs.s||[]).forEach(f=>f(v));return Promise.resolve()},
  signIn(){return Promise.resolve({email:"demo"})}, signOut(){return Promise.resolve()},
  onUser(cb){cb({email:"demo"})}
};

const Fire = {
  db:null, auth:null,
  async init(){
    const v="10.12.2", base=`https://www.gstatic.com/firebasejs/${v}/`;
    for (const f of ["firebase-app-compat.js","firebase-auth-compat.js","firebase-firestore-compat.js"]) await loadScript(base+f);
    firebase.initializeApp(FIREBASE_CONFIG); this.db=firebase.firestore(); this.auth=firebase.auth();
  },
  watchProducts(cb){this.db.collection("products").onSnapshot(s=>cb(s.docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>(b.ts||0)-(a.ts||0))),e=>{console.error(e);cb([])})},
  saveProduct(p){const {id,...d}=p;return this.db.collection("products").doc(id).set(d)},
  deleteProduct(id){return this.db.collection("products").doc(id).delete()},
  createOrder(o){const {id,...d}=o;return this.db.collection("orders").doc(id).set(d)},
  watchOrders(cb){return this.db.collection("orders").orderBy("ts","desc").limit(300).onSnapshot(s=>cb(s.docs.map(d=>({id:d.id,...d.data()}))),e=>{console.error(e);toast("ما عندكش الصلاحية تشوف الطلبيات");cb([])})},
  updateOrder(id,patch){return this.db.collection("orders").doc(id).update(patch)},
  deleteOrder(id){return this.db.collection("orders").doc(id).delete()},
  watchSettings(cb){this.db.collection("settings").doc("shop").onSnapshot(d=>cb(d.exists?d.data():{}),e=>{console.error(e);cb({})})},
  saveSettings(v){return this.db.collection("settings").doc("shop").set(v)},
  signIn(){const p=new firebase.auth.GoogleAuthProvider();return this.auth.signInWithPopup(p).catch(()=>this.auth.signInWithRedirect(p))},
  signOut(){return this.auth.signOut()},
  onUser(cb){this.auth.onAuthStateChanged(u=>cb(u))}
};
function loadScript(src){return new Promise((ok,no)=>{const s=document.createElement("script");s.src=src;s.onload=ok;s.onerror=no;document.head.appendChild(s)})}

let DB = Demo;

/* ============================================================
   3) الحالة العامة
   ============================================================ */
const S = {products:[], cat:"الكل", q:"", cart: ls("le_cart")||[], user:null, orders:[], aTab:"orders", oFilter:"new", unsubOrders:null};
const saveCart = () => ls("le_cart", S.cart);

/* الكميات بالوزن */
function weightOptions(){
  const r = SHOP.ratlGrams;
  return [{g:250,l:"ربع كيلو"},{g:r,l:"رطل"},{g:1000,l:"1 كغ"},{g:2000,l:"2 كغ"},{g:5000,l:"5 كغ"}];
}
function qtyLabel(it){
  if (it.unit==="kg"){
    const g=it.grams;
    if (g===SHOP.ratlGrams) return "رطل ("+g+" غ)";
    if (g>=1000) return (g/1000).toString().replace(".",",")+" كغ";
    return g+" غ";
  }
  return it.qty+" × حبة";
}
function lineTotal(it){return it.unit==="kg" ? it.price*it.grams/1000 : it.price*it.qty}
function priceLabel(p){return p.unit==="kg" ? `${fmt(p.price)} <small>/ الكيلو</small>` : `${fmt(p.price)} <small>/ ${esc(p.unitName||"الحبة")}</small>`}

/* ============================================================
   4) واجهة الزبون
   ============================================================ */
function header(admin=false){
  const n = S.cart.length;
  return `<header><div class="hrow">
    <div class="brand"><img src="${LOGO}" alt=""><div><b>${esc(SHOP.name)}</b><small>${admin?"لوحة المدير":esc(SHOP.tagline)}</small></div></div>
