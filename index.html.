  return `<div class="card ord">
    <div class="arow"><div class="t"><b>طلب #${esc(x.code)}</b><small>${d.toLocaleDateString("ar-DZ")} ${d.toLocaleTimeString("ar-DZ",{hour:"2-digit",minute:"2-digit"})}</small></div><span class="st st-${x.status}">${STATUS[x.status]||x.status}</span></div>
    <div class="who">👤 <b>${esc(c.first)} ${esc(c.last)}</b><br>📞 <a href="tel:${esc(c.phone)}">${esc(c.phone)}</a><br>📍 ${String(c.wilaya||"").padStart(2,"0")} ${esc(c.wilayaName)} — ${esc(c.address)}${c.note?`<br>📝 ${esc(c.note)}`:""}</div>
    <div class="items">${(x.items||[]).map(i=>`<div><span>${esc(i.name)} — ${esc(i.label)}</span><b>${fmt(i.total)}</b></div>`).join("")}<div style="border-top:1px dashed #E5D5C7;margin-top:4px;padding-top:6px"><span>المجموع</span><b>${fmt(x.total||0)}</b></div></div>
    <div class="acts">
      ${next?`<button class="mini" style="background:var(--brand);color:#fff" onclick="setStatus('${x.id}','${next[0]}')">${next[1]}</button>`:""}
      <a class="mini" style="text-decoration:none;color:#fff;background:#1FAF5A" target="_blank" href="https://wa.me/${waNum(c.phone)}?text=${encodeURIComponent(wmsg)}">💬 واتساب</a>
      <a class="mini" style="text-decoration:none;color:inherit" href="tel:${esc(c.phone)}">📞 اتصال</a>
      <button class="mini" onclick="openBon(S.orders.find(o=>o.id==='${x.id}'))">🧾 البون</button>
      ${x.status!=="cancel"&&x.status!=="done"?`<button class="mini red" onclick="askYes('تلغي هاد الطلب؟',()=>setStatus('${x.id}','cancel'))">إلغاء</button>`:""}
      ${x.status==="cancel"?`<button class="mini red" onclick="askYes('تحذف الطلب نهائياً؟',()=>DB.deleteOrder('${x.id}'))">حذف</button>`:""}
    </div></div>`;
}
function setStatus(id,s){DB.updateOrder(id,{status:s}).then(()=>toast("تبدّلت الحالة: "+STATUS[s])).catch(e=>{console.error(e);toast("ما تبدّلتش، شوف الصلاحيات")})}


/* ============================================================
   إعدادات المحل (الاسم، الشعار، الأرقام...)
   ============================================================ */
const DEF_SHOP={...SHOP}, DEF_LOGO=LOGO;
function applySettings(v){
  v=v||{};
  Object.assign(SHOP, DEF_SHOP, v);
  if(typeof v.phones==="string") SHOP.phones=v.phones.split(/[,،\n]/).map(x=>x.trim()).filter(Boolean);
  SHOP.ratlGrams=Number(SHOP.ratlGrams)||500;
  LOGO=v.logo||DEF_LOGO;
}
let ES={};
function renderSettings(b){
  ES={name:SHOP.name,tagline:SHOP.tagline,address:SHOP.address,phones:SHOP.phones.join(" , "),whatsapp:SHOP.whatsapp,delivery:SHOP.delivery,payment:SHOP.payment,ratlGrams:SHOP.ratlGrams,logo:LOGO===DEF_LOGO?"":LOGO};
  const f=(id,l,ph="",type="text")=>`<label class="f">${l}</label><input class="in" id="s_${id}" type="${type}" ${["phones","whatsapp","ratlGrams","address"].includes(id)?'dir="ltr" style="text-align:left"':""} value="${esc(ES[id])}" placeholder="${esc(ph)}">`;
  b.innerHTML=`<div class="card">
    <div class="imgpick"><img id="s_prev" class="prev" src="${LOGO}" style="object-fit:contain;background:#fff">
      <div style="display:flex;flex-direction:column;gap:6px"><label class="mini" style="cursor:pointer">🖼️ بدّل الشعار<input type="file" accept="image/*" class="hidden" onchange="pickLogo(this)"></label>
      <button class="mini" onclick="ES.logo='';$('#s_prev').src=DEF_LOGO">رجّع الشعار الأصلي</button></div></div>
    ${f("name","اسم المحل")}
    ${f("tagline","الجملة تحت الاسم")}
    ${f("address","العنوان (يبان في البون)","Adrar / Aoulef / Oumanat")}
    ${f("phones","أرقام الهاتف (فرّق بينهم بفاصلة ,)","0665 81 36 29 , 0674 08 23 48")}
    ${f("whatsapp","رقم الواتساب اللي توصلك فيه الطلبيات","0665813629")}
    ${f("delivery","جملة التوصيل")}
    ${f("payment","طريقة الدفع (تبان في البون)")}
    ${f("ratlGrams","الرطل = شحال من غرام؟","500","number")}
    <div class="err" id="s_err"></div>
    <button class="btn" id="s_save" onclick="saveSettings()">💾 حفظ إعدادات المحل</button>
  </div>
  <div class="note">🔐 إيميل المدير ما يتبدلش من هنا (للحماية). إذا تحب تبدّلو، قولّي ونبدّلوه في الكود.</div>`;
}
function pickLogo(inp){
  const f=inp.files[0]; if(!f) return;
  const r=new FileReader(); r.onload=()=>{const im=new Image();im.onload=()=>{
    const M=300,sc=Math.min(1,M/Math.max(im.width,im.height)),c=document.createElement("canvas");
    c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);c.getContext("2d").drawImage(im,0,0,c.width,c.height);
    ES.logo=c.toDataURL("image/png"); if(ES.logo.length>250000) ES.logo=c.toDataURL("image/jpeg",0.85);
    $("#s_prev").src=ES.logo;
  };im.src=r.result}; r.readAsDataURL(f);
}
async function saveSettings(){
  const g=id=>$("#s_"+id).value.trim();
  const v={name:g("name")||DEF_SHOP.name,tagline:g("tagline"),address:g("address"),phones:g("phones"),whatsapp:g("whatsapp").replace(/\s/g,""),
    delivery:g("delivery"),payment:g("payment"),ratlGrams:Number(g("ratlGrams"))||500,logo:ES.logo||""};
  if(!/^0\d{8,9}$/.test(v.whatsapp)){$("#s_err").textContent="رقم الواتساب ماشي صحيح (مثال: 0665813629)";return}
  $("#s_save").disabled=true;
  try{await DB.saveSettings(v);toast("✅ تحفظت إعدادات المحل");renderAdmin()}
  catch(e){console.error(e);$("#s_err").textContent="ما تحفظتش، شوف الصلاحيات";$("#s_save").disabled=false}
}

let ep={};
function editProduct(id){
  const p=id?S.products.find(x=>x.id===id):null;
  ep=p?{...p}:{id:uid(),name:"",cat:"",unit:"piece",unitName:"حبة",price:"",img:"",desc:"",active:true,stock:true};
  const catList=[...new Set(S.products.map(x=>x.cat).filter(Boolean))];
  modal(`<h2>${p?"تعديل السلعة":"سلعة جديدة"}<button class="x" onclick="closeModal()">×</button></h2>
    <div class="imgpick"><div id="e_prev">${ep.img?`<img class="prev" src="${ep.img}">`:`<div class="prev">📷</div>`}</div>
      <label class="mini" style="cursor:pointer">📷 اختار صورة<input type="file" accept="image/*" class="hidden" onchange="pickImg(this)"></label></div>
    <label class="f">اسم السلعة</label><input class="in" id="e_name" value="${esc(ep.name)}" placeholder="مثلاً: شوكولا سوداء">
    <label class="f">الصنف</label><input class="in" id="e_cat" list="catl" value="${esc(ep.cat)}" placeholder="مثلاً: شوكولا، تزيين، تغليف"><datalist id="catl">${catList.map(c=>`<option value="${esc(c)}">`).join("")}</datalist>
    <label class="f">كيفاش تتباع؟</label>
    <div class="seg"><button id="u_piece" class="${ep.unit!=="kg"?"on":""}" onclick="ep.unit='piece';uSync()">🔢 بالحبة / العلبة</button><button id="u_kg" class="${ep.unit==="kg"?"on":""}" onclick="ep.unit='kg';uSync()">⚖️ بالميزان (الكيلو)</button></div>
    <div class="row2"><div><label class="f" id="e_plab">السعر (دج)</label><input class="in" id="e_price" inputmode="decimal" value="${esc(ep.price)}"></div>
    <div id="e_unitbox"><label class="f">الوحدة</label><input class="in" id="e_unit" value="${esc(ep.unitName||"حبة")}" placeholder="حبة، علبة، كيس..."></div></div>
    <label class="f">وصف قصير (اختياري)</label><textarea class="in" id="e_desc" rows="2">${esc(ep.desc)}</textarea>
    <div class="seg" style="margin-top:12px"><button id="e_stock" class="${ep.stock!==false?"on":""}" onclick="ep.stock=!(ep.stock!==false);this.classList.toggle('on');this.textContent=ep.stock!==false?'✅ متوفرة':'⛔ نفدت'">${ep.stock!==false?"✅ متوفرة":"⛔ نفدت"}</button>
    <button id="e_act" class="${ep.active!==false?"on":""}" onclick="ep.active=!(ep.active!==false);this.classList.toggle('on');this.textContent=ep.active!==false?'👁️ ظاهرة للزبائن':'🙈 مخفية'">${ep.active!==false?"👁️ ظاهرة للزبائن":"🙈 مخفية"}</button></div>
    <div class="err" id="e_err"></div>
    <button class="btn" id="e_save" onclick="saveProd()">💾 حفظ</button>
    ${p?`<button class="btn ghost" style="margin-top:8px;color:var(--bad)" onclick="askYes('تحذف هاد السلعة؟',()=>DB.deleteProduct('${p.id}').then(()=>{closeModal();toast('تحذفت')}))">🗑️ حذف السلعة</button>`:""}`);
  uSync();
}
function uSync(){
  $("#u_piece").classList.toggle("on",ep.unit!=="kg");$("#u_kg").classList.toggle("on",ep.unit==="kg");
  $("#e_unitbox").style.visibility=ep.unit==="kg"?"hidden":"visible";
  $("#e_plab").textContent=ep.unit==="kg"?"سعر الكيلو (دج)":"السعر (دج)";
}
function pickImg(inp){
  const f=inp.files[0]; if(!f) return;
  const r=new FileReader(); r.onload=()=>{const im=new Image();im.onload=()=>{
    const M=640, s=Math.min(1,M/Math.max(im.width,im.height)); const c=document.createElement("canvas");
    c.width=Math.round(im.width*s);c.height=Math.round(im.height*s);c.getContext("2d").drawImage(im,0,0,c.width,c.height);
    ep.img=c.toDataURL("image/jpeg",0.72); $("#e_prev").innerHTML=`<img class="prev" src="${ep.img}">`;
  };im.src=r.result}; r.readAsDataURL(f);
}
async function saveProd(){
  ep.name=$("#e_name").value.trim(); ep.cat=$("#e_cat").value.trim(); ep.price=parseFloat(String($("#e_price").value).replace(",","."));
  ep.unitName=ep.unit==="kg"?"":($("#e_unit").value.trim()||"حبة"); ep.desc=$("#e_desc").value.trim();
  if(!ep.name){$("#e_err").textContent="اكتب اسم السلعة";return}
  if(!(ep.price>0)){$("#e_err").textContent="اكتب السعر";return}
  ep.ts=ep.ts||Date.now();
  $("#e_save").disabled=true;
  try{await DB.saveProduct({...ep});closeModal();toast("✅ تحفظت السلعة")}
  catch(e){console.error(e);$("#e_err").textContent="ما تحفظتش (شوف الصلاحيات ولا حجم الصورة)";$("#e_save").disabled=false}
}

/* ============================================================
   6) التشغيل
   ============================================================ */
function go(h){location.hash=h}
function route(){closeModal(); if(location.hash==="#admin") renderAdmin(); else renderShop()}
window.addEventListener("hashchange",route);
(async function start(){
  if(FIREBASE_CONFIG){
    try{await Fire.init();DB=Fire}catch(e){console.error(e);toast("مشكل في الاتصال، راك في وضع التجربة");DB=Demo}
  }
  if(DB===Demo) $("#demoBar").classList.remove("hidden");
  DB.watchSettings(v=>{applySettings(v); if(location.hash==="#admin"){ if(S.aTab!=="settings") renderAdmin(); } else route();});
  DB.watchProducts(p=>{S.products=p;
    S.cart=S.cart.filter(i=>p.some(x=>x.id===i.pid)||!p.length);
    if(location.hash==="#admin"){renderAdminBody()} else if($("#grid")) renderGrid(); else route();
  });
  DB.onUser(u=>{S.user=u; if(location.hash==="#admin") renderAdmin()});
  route();
})();
</script>
